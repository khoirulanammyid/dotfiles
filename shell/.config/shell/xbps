#!/bin/sh

xin() {
    local pkgs
    pkgs=$(xbps-query -Rs '*' | awk '{print $2}' | \
        fzf -m --prompt="Install package: " \
            --preview 'xbps-query -R {}' \
            --preview-window=right:60%:wrap)

    [[ -z "$pkgs" ]] && return

    echo "$pkgs" | xargs -ro sudo xbps-install -S
}

xrm() {
    xbps-query -m | \
    fzf --prompt="Remove package: " \
        --multi | \
    xargs -ro sudo xbps-remove -Rov
}
