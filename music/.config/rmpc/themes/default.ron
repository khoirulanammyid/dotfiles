#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " ",
    browser_column_widths: [25, 45, 30],
    background_color: Some("rgb(40, 40, 40)"),
    text_color: Some("rgb(235, 219, 178)"),
    header_background_color: None,
    modal_background_color: Some("rgb(50, 48, 47)"),
    modal_backdrop: true,
    
    preview_label_style: (fg: "rgb(168, 153, 132)"),
    preview_metadata_group_style: (fg: "rgb(250, 189, 47)", modifiers: "Bold"),
    highlighted_item_style: (fg: "rgb(250, 189, 47)", modifiers: "Bold"),
    current_item_style: (fg: "rgb(250, 189, 47)", modifiers: "Bold"),
    
    borders_style: (fg: "rgb(40, 40, 40)"),
    highlight_border_style: (fg: "rgb(40, 40, 40)"),
    
    symbols: (
        song: " ",
        dir: " ",
        playlist: " ",
        marker: " ",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
        marker_style: None,
        song_highlighted_style: None,
        dir_highlighted_style: None,
        playlist_highlighted_style: None,
        marker_highlighted_style: None,
        song_current_style: None,
        dir_current_style: None,
        playlist_current_style: None,
        marker_current_style: None,
    ),
    level_styles: (
        info: (fg: "rgb(131, 165, 152)"),
        warn: (fg: "rgb(250, 189, 47)"),
        error: (fg: "rgb(204, 36, 29)"),
        debug: (fg: "rgb(184, 187, 38)"),
        trace: (fg: "rgb(211, 134, 155)"),
    ),
    progress_bar: (
        symbols: ["─", "─", "─", " ", "─"],
        track_style: (fg: "rgb(80, 73, 69)"),
        elapsed_style: (fg: "rgb(250, 189, 47)"),
        thumb_style: (fg: "rgb(250, 189, 47)"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: [" ", " ", " ", " "], 
        track_style: (),
        ends_style: (),
        thumb_style: (),
    ),
    tab_bar: (
        active_style: (fg: "rgb(250, 189, 47)", modifiers: "Bold"),
        inactive_style: (fg: "rgb(168, 153, 132)"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist), default: (kind: Text("Unknown"))),
            label_prop: (kind: Text(" ")), 
            width: "25%",
        ),
        (
            prop: (kind: Property(Title), default: (kind: Text("Unknown"))),
            label_prop: (kind: Text(" ")), 
            width: "45%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "rgb(168, 153, 132)"), default: (kind: Text("Unknown"), style: (fg: "rgb(168, 153, 132)"))),
            label_prop: (kind: Text(" ")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "rgb(168, 153, 132)"), default: (kind: Text("-"))),
            label_prop: (kind: Text(" ")),
            width: "10%",
            alignment: Right,
        ),
    ],
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "40%",
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                                (size: "40%", pane: Pane(AlbumArt)),
                                (size: "2", pane: Pane(Empty())),
                                (size: "100%", pane: Pane(Lyrics)),
                            ]
                        )
                    ),
                    (size: "100%", pane: Pane(Queue)),
                ]
            )
        ),
        (name: "Directories", pane: Pane(Directories)),
        (name: "Artists", pane: Pane(Artists)),
        (name: "Albums", pane: Pane(Albums)),
        (name: "Playlists", pane: Pane(Playlists)),
        (name: "Search", pane: Pane(Search)),
    ],
    layout: Split(
        direction: Horizontal,
        panes: [
            (size: "2", pane: Pane(Empty())), 
            (
                size: "100%",
                pane: Split(
                    direction: Vertical,
                    panes: [
                        (size: "1", pane: Pane(Empty())), 
                        (
                            size: "1",
                            pane: Split(
                                direction: Horizontal,
                                panes: [
                                    (size: "100%", pane: Component("header_left")),
                                ]
                            )
                        ),
                        (size: "1", pane: Pane(Empty())),
                        (
                            pane: Pane(Tabs),
                            size: "1",
                        ),
                        (
                            pane: Pane(TabContent),
                            size: "100%",
                        ),
                        (size: "1", pane: Pane(Empty())),
                        (
                            size: "1",
                            pane: Component("footer"),
                        ),
                        (size: "1", pane: Pane(Empty())), 
                    ],
                )
            ),
            (size: "2", pane: Pane(Empty())), 
        ],
    ),
    components: {
        "header_left": Pane(Property(
            content: [
                (kind: Property(Status(StateV2( ))), style: (fg: "rgb(250, 189, 47)", modifiers: "Bold")),
                (kind: Text(" ")),
                (kind: Property(Song(Title)), style: (fg: "rgb(235, 219, 178)", modifiers: "Bold"), default: (kind: Text("No Song"))),
                (kind: Text(" - "), style: (fg: "rgb(168, 153, 132)")),
                (kind: Property(Song(Artist)), style: (fg: "rgb(168, 153, 132)"), default: (kind: Text("Unknown"))),
            ], align: Left
        )),
        "footer": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "8",
                    pane: Pane(Property(content: [
                        (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                            (match: "Normal", replace: (kind: Text("N"), style: (fg: "rgb(168, 153, 132)"))),
                            (match: "Insert", replace: (kind: Text("I"), style: (fg: "rgb(250, 189, 47)", modifiers: "Bold"))),
                        ])))
                    ], align: Left))
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "15",
                    pane: Pane(Property(content: [
                        (kind: Property(Status(Elapsed)), style: (fg: "rgb(235, 219, 178)")),
                        (kind: Text("/"), style: (fg: "rgb(124, 111, 100)")),
                        (kind: Property(Status(Duration)), style: (fg: "rgb(168, 153, 132)")),
                    ], align: Right))
                ),
                (
                    size: "8",
                    pane: Pane(Property(content: [
                        (kind: Text("vol "), style: (fg: "rgb(124, 111, 100)")),
                        (kind: Property(Status(Volume)), style: (fg: "rgb(168, 153, 132)")),
                    ], align: Right))
                ),
            ]
        )
    },
)
