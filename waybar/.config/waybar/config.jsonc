{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin-top": 16,
    "margin-left": 16,
    "margin-right": 16,
    "margin-bottom": 0,
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [],
    "modules-right": [
        "wireplumber#sink",
        "backlight",
        "network",
        "tray",
        "battery",
        "clock"
    ],
    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true,
        "disable-scroll": true,
        "format-icons": {
            "default": "",
            "active": "",
            "urgent": ""
        }
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 80
    },
    "clock": {
        "format": "{:%a %b %d %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "first-day-of-week": 1,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#e8b770'><b>{}</b></span>",
                "days": "<span color='#d4be98'><b>{}</b></span>",
                "weeks": "<span color='#7daea3'><b>W{}</b></span>",
                "weekdays": "<span color='#a9b665'><b>{}</b></span>",
                "today": "<span color='#e58273'><b><u>{}</u></b></span>"
            }
        }
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 60
    },
    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} - {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 30,
        "on-click": "footclient -e impala"
    },
    "wireplumber#sink": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-right-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click": "footclient -e wiremix"
    },
    "backlight": {
        "format": "󰃛 {percent}%",
        "on-click": "toggle-gammastep"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 4
    }
}
