{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin": 0,
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
    ],

    "modules-right": [
        "wireplumber#sink",
        "backlight",
        "network",
	"idle_inhibitor",
        "tray",
        "battery",
        "clock"
    ],

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true,
        "disable-scroll": true,
        "format-icons": {
            "default": "",
            "active": "",
            "urgent": ""
        }
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 45
    },
    "clock": {
        "format": "{:%a %b %d %H:%M}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>",
	"calendar": {
		"mode"             : "year",
		"mode-mon-col"     : 3,
		"weeks-pos"        : "right",
		"first-day-of-week": 1,
		"on-scroll"        : 1,
		"on-click-right"   : "mode",
		"format": {
			"months":     "<span color='#e8b770'><b>{}</b></span>",
			"days":       "<span color='#d4be98'><b>{}</b></span>",
			"weeks":      "<span color='#7daea3'><b>W{}</b></span>",
			"weekdays":   "<span color='#a9b665'><b>{}</b></span>",
			"today":      "<span color='#e58273'><b><u>{}</u></b></span>"
		}
	}
    },
    "battery": {
        "format": "{capacity}%",
        "format-charging": "+{capacity}%",
        "format-plugged": "PWR",
	"interval": 60
    },
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "{ifname}",
        "format-disconnected": "OFF",
	"tooltip-format": "{ifname}",
	"tooltip-format-wifi": "{ifname} - {ipaddr} - {signalStrength}%",
	"tooltip-format-ethernet": "{ifname} - {ipaddr}",
	"tooltip-format-disconnected": "Disconnected",
	"max-length": 30

    },
    "wireplumber#sink": {
        "format": "VOL: {volume}%",
        "format-muted": "MUTE",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "backlight": {
        "format": "BRI: {percent}%"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 4
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "CAFF",
            "deactivated": "IDLE"
        },
        "tooltip": true,
        "tooltip-format-activated": "Inhibitor Active (No Sleep)",
        "tooltip-format-deactivated": "Inhibitor Inactive (Normal Sleep)"
    },
}
